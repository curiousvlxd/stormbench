      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "runstore"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  r.started_at AS \"Started\",\n  coalesce(r.storm_label, r.storm) AS \"Storm\",\n  coalesce(r.algorithm_label, r.algorithm) AS \"Algorithm\",\n  r.state AS \"State\",\n  r.steps AS \"Steps\",\n  r.overflow_m3 AS \"Overflow\",\n  r.base_case_m3 AS \"Base Case\",\n  r.change_pct AS \"Change\",\n  r.mismatches AS \"Mismatches\",\n  (SELECT count(*) FROM alarm_journal j WHERE j.run_id = r.id AND j.to_state = 'Unacknowledged') AS \"Alarms\",\n  r.id AS \"Run\",\n  r.storm AS storm_id,\n  (extract(epoch FROM r.storm_start) * 1000)::bigint AS from_ms,\n  (extract(epoch FROM r.storm_end) * 1000)::bigint AS to_ms\nFROM runs r\nORDER BY r.started_at DESC\nLIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm"
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Overflow|Base Case)$"
            },
            "properties": [
              {
