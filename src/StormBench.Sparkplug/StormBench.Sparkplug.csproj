<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Minimal Sparkplug B 3.0 edge node and primary host application on MQTTnet 5.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="Protos\sparkplug_b.proto" GrpcServices="None" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StormBench.Sparkplug.Tests" />
  </ItemGroup>

</Project>
