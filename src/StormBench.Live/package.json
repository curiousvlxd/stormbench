{
  "name": "stormbench-live",
  "version": "0.0.0",
  "private": true,
  "description": "The Live 3D view of StormBench: the town in a storm, rendered with three.js.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "polygon-clipping": "0.15.7",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/three": "0.180.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
