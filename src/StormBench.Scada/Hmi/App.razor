<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <title>StormBench</title>
    <link rel="icon" href="@Assets["favicon.svg"]" type="image/svg+xml" />
    <link rel="preload" href="fonts/SourceSans3-Variable.ttf" as="font" type="font/ttf" crossorigin />
    <script src="@Assets["theme.js"]"></script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["hmi.css"]" />
    <link rel="stylesheet" href="@Assets["live.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveNoPrerender" />
</head>

<body>
    <Routes @rendermode="InteractiveNoPrerender" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    /// <summary>
    /// The pages show live data from the feed and the 3D view, both only once the circuit is up:
    /// render interactively only, with no static page to be replaced.
    /// </summary>
    private static readonly IComponentRenderMode InteractiveNoPrerender = new InteractiveServerRenderMode(prerender: false);
}
