<header class="statusbar">
    <div class="brand">
        <span class="brand-site">Astlingen</span>
        <span class="brand-display">Network overview</span>
    </div>
    <nav class="view-tabs" aria-label="Views">
        <a class="view-tab" href="">Live 3D</a>
        <a class="view-tab active" href="operator" aria-current="page">Operator SCADA</a>
    </nav>
    <div class="clock">
        <span class="clock-label">@(View.Scenario.Clock is null ? "No storm run yet" : "Simulated time")</span>
        <span class="clock-value">@Fmt.Clock(View.Scenario.Clock)</span>
    </div>
    <ul class="comms" aria-label="Communication">
        @Comm("Broker", "MQTT broker of the UNS", View.Site.Broker)
        @Comm("Edge01", "Edge gateway next to the PLC", View.Site.Edge)
        @Comm("PLC01", "PLC: OpenPLC runtime, IEC 61131-3", View.Site.Plc)
        @Comm("Sim01", "Simulator: EPA SWMM, the simulated field", View.Site.Sim)
    </ul>
    <button type="button" class="theme-toggle" @onclick="OnToggleTheme"
            aria-label="@(Theme == "dark" ? "Switch to the light theme" : "Switch to the dark theme")"
            title="@(Theme == "dark" ? "Light theme" : "Dark theme")">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            @if (Theme == "dark")
            {
                <circle cx="12" cy="12" r="4.5" />
                <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" />
            }
            else
            {
                <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" />
            }
        </svg>
    </button>
</header>

@code {
    [Parameter, EditorRequired] public HmiView View { get; set; } = default!;
    [Parameter] public string Theme { get; set; } = "light";
    [Parameter] public EventCallback OnToggleTheme { get; set; }

    private static RenderFragment Comm(string name, string title, Presence presence) => __builder =>
    {
        var (state, css) = presence switch
        {
            Presence.Online => ("ok", "ok"),
            Presence.Offline => ("stale", "bad"),
            _ => ("waiting", "unknown"),
        };
        <li class="comm @css" title="@title: @state">
            @if (presence is Presence.Offline)
            {
                <AlarmBadge Priority="AlarmPriority.High" />
            }
            else
            {
                <span class="comm-dot" aria-hidden="true"></span>
            }
            <span class="comm-name">@name</span>
            <span class="comm-state">@state</span>
        </li>
    };
}
