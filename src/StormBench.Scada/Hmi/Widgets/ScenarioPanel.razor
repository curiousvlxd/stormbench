@inject StartStormHandler Start
@inject StopStormHandler Stop
@inject SetCenterLinkHandler CenterLink
@inject JamGateHandler Jam
@inject FreezeSensorHandler Freeze

<section class="panel console" aria-labelledby="console-title">
    <header class="panel-head">
        <h2 id="console-title">Test console</h2>
        <span class="panel-note">Runs the simulated storm, not the plant</span>
    </header>

    @if (Status.Catalog is not { } catalog)
    {
        <p class="muted">@(Status.Simulator is Presence.Online ? "Waiting for the simulator's catalog." : "Simulator offline. Start it to run storms.")</p>
    }
    else
    {
        var storm = catalog.Storm(Status.Busy ? Status.Storm : _storm) ?? catalog.Storms[0];
        var algorithm = catalog.Algorithm(Algorithm(catalog)) ?? catalog.Algorithms[0];
        var locked = Status.Busy || _pending;
        <div class="field">
            <label class="field-label" for="console-storm">Storm</label>
            <select id="console-storm" class="select" disabled="@locked" value="@storm.Id.Value" @onchange="OnStormChanged">
                @foreach (var option in catalog.Storms)
                {
                    <option value="@option.Id.Value">@option.Label</option>
                }
            </select>
            <p class="hint">@storm.Description. @Fmt.Count(storm.Steps) steps of 5 min.</p>
        </div>

        <fieldset class="field">
            <legend class="field-label">Control</legend>
            <div class="choices">
                @foreach (var option in catalog.Algorithms)
                {
                    var id = option.Id;
                    var on = id == algorithm.Id;
                    <label class="choice @(on ? "selected" : null)">
                        <input type="radio" name="console-algorithm" value="@id.Value" checked="@on" disabled="@locked" @onchange="() => _algorithm = id" />
                        <span class="choice-label">@option.Label</span>
                    </label>
                }
            </div>
            <p class="hint">@algorithm.Description.</p>
        </fieldset>

        <div class="field">
            <span class="field-label" id="console-speed">Speed, control steps per second</span>
            <div class="segmented" role="group" aria-labelledby="console-speed">
                @foreach (var pace in catalog.Paces)
                {
                    var selected = Math.Abs(pace - Pace(catalog)) < 1e-9;
                    var value = pace;
                    <button type="button" class="@(selected ? "on" : null)" aria-pressed="@(selected ? "true" : "false")" disabled="@locked" @onclick="() => _pace = value">
                        @Fmt.Pace(pace)
                    </button>
                }
            </div>
            <p class="hint">@Fmt.PaceHint(Pace(catalog), 300).</p>
        </div>

        <div class="actions">
            <button type="button" id="console-start" class="button primary" disabled="@(!Status.CanStart || _pending)" @onclick="() => StartAsync(catalog)">
                <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true"><path class="filled" d="M8 5v14l11-7z" /></svg>
                Start storm
            </button>
            <button type="button" id="console-stop" class="button" disabled="@(!Status.CanStop || _pending)" @onclick="StopAsync">
                <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true"><rect class="filled" x="6.5" y="6.5" width="11" height="11" rx="2" /></svg>
                Stop
            </button>
        </div>
    }

    <RunState Status="Status" />

    <div class="faults">
        <h3 class="field-label">Faults</h3>
        <div class="field">
            <button type="button" id="fault-center-link" class="button fault @(Status.CenterLinkCut ? "active" : null)"
                    disabled="@(!Status.CanInjectFaults || _faultPending)" @onclick="ToggleCenterLinkAsync">
                @(Status.CenterLinkCut ? "Restore link to center" : "Cut link to center")
            </button>
            <p class="hint">
                @(Status.CenterLinkCut
                    ? "Link cut: with proposals from the center the PLC stations run locally."
                    : "With proposals from the center, the PLC falls back to local control when the center stays silent for 2 s.")
            </p>
        </div>
        @if (Network is { } network)
        {
            <div class="field fault-pair">
                <div>
                    <label class="field-label" for="fault-stuck-gate">Stuck gate</label>
                    <select id="fault-stuck-gate" class="select" value="@(Status.StuckGate?.Value ?? NoFault)" disabled="@(!Status.CanInjectFaults || _faultPending)"
                            @onchange="OnStuckGateChanged">
                        <option value="@NoFault">None</option>
                        @foreach (var station in network.Stations)
                        {
                            <option value="@station.Gate.Value">@station.Gate (tank @station.Tank)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="field-label" for="fault-frozen-sensor">Frozen level sensor</label>
                    <select id="fault-frozen-sensor" class="select" value="@(Status.FrozenSensor?.Value ?? NoFault)" disabled="@(!Status.CanInjectFaults || _faultPending)"
                            @onchange="OnFrozenSensorChanged">
                        <option value="@NoFault">None</option>
                        @foreach (var tank in network.Tanks)
                        {
                            <option value="@tank.Value">@tank</option>
                        }
                    </select>
                </div>
            </div>
            <p class="hint">A stuck gate ignores the PLC; a frozen sensor feeds it an old level. Scada notices both from position feedback and a level that stops moving.</p>
        }
    </div>

    @if (_refusal is not null)
    {
        <p class="notice" role="status">@_refusal</p>
    }
    else if (Status.Message is { } message && !Status.Busy)
    {
        <p class="notice" role="status">@message</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public ScenarioStatus Status { get; set; } = default!;

    /// <summary>The network, for the fault targets (outlets and tanks).</summary>
    [Parameter] public DrainageNetwork? Network { get; set; }

    private const string NoFault = "none";

    private StormId? _storm;
    private AlgorithmId? _algorithm;
    private double? _pace;
    private bool _pending;
    private bool _faultPending;
    private string? _refusal;
    private long _pendingRun;
    private DateTime _pendingAt;

    /// <summary>How long the console waits for the simulator to take up a start command.</summary>
    private static readonly TimeSpan PendingTimeout = TimeSpan.FromSeconds(3);

    /// <summary>While a storm runs the console shows its settings, otherwise the operator's choice.</summary>
    private AlgorithmId Algorithm(ScenarioCatalog catalog) =>
        (Status.Busy ? Status.Algorithm : null) ?? _algorithm ?? Status.Algorithm ?? catalog.DefaultAlgorithm;

    private double Pace(ScenarioCatalog catalog) => (Status.Busy ? Status.Pace : null) ?? _pace ?? catalog.DefaultPace;

    protected override void OnParametersSet()
    {
        if (Status.Catalog is { } catalog)
        {
            _storm ??= Status.Storm ?? catalog.DefaultStorm;
        }
        if (_pending && (Status.Run != _pendingRun || Status.Busy || DateTime.UtcNow - _pendingAt > PendingTimeout))
        {
            _pending = false;
        }
    }

    private void OnStormChanged(ChangeEventArgs e) => _storm = e.Value as string is { Length: > 0 } storm ? new StormId(storm) : _storm;

    private Task OnStuckGateChanged(ChangeEventArgs e) =>
        RunFaultCommandAsync(() => Jam.HandleAsync(new JamGate(Target(e) is { } gate ? new GateId(gate) : null), CancellationToken.None));

    private Task OnFrozenSensorChanged(ChangeEventArgs e) =>
        RunFaultCommandAsync(() => Freeze.HandleAsync(new FreezeSensor(Target(e) is { } tank ? new TankId(tank) : null), CancellationToken.None));

    /// <summary>The fault target picked, or null for none.</summary>
    private static string? Target(ChangeEventArgs e) => e.Value as string is { Length: > 0 } target and not NoFault ? target : null;

    private async Task StartAsync(ScenarioCatalog catalog)
    {
        _refusal = null;
        _pending = true;
        _pendingRun = Status.Run;
        _pendingAt = DateTime.UtcNow;
        var storm = catalog.Storm(_storm) ?? catalog.Storms[0];
        var result = await Start.HandleAsync(new StartStorm(storm.Id, Algorithm(catalog), Pace(catalog)), CancellationToken.None);
        if (!result.Accepted)
        {
            _pending = false;
            _refusal = result.Reason;
        }
    }

    private async Task StopAsync()
    {
        _refusal = null;
        var result = await Stop.HandleAsync(CancellationToken.None);
        if (!result.Accepted)
        {
            _refusal = result.Reason;
        }
    }

    private Task ToggleCenterLinkAsync() =>
        RunFaultCommandAsync(() => CenterLink.HandleAsync(new SetCenterLink(!Status.CenterLinkCut), CancellationToken.None));

    private async Task RunFaultCommandAsync(Func<Task<CommandResult>> command)
    {
        _refusal = null;
        _faultPending = true;
        try
        {
            var result = await command();
            if (!result.Accepted)
            {
                _refusal = result.Reason;
            }
        }
        finally
        {
            _faultPending = false;
        }
    }
}
