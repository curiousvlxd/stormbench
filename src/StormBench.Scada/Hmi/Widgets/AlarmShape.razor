@switch (Priority)
{
    case AlarmPriority.High:
        <rect class="alarm-shape" x="-100" y="-100" width="200" height="200" rx="40" />
        break;
    case AlarmPriority.Medium:
        <path class="alarm-shape" d="M 0 -122 L 120 96 L -120 96 Z" />
        break;
    default:
        <path class="alarm-shape" d="M 0 -125 L 125 0 L 0 125 L -125 0 Z" />
        break;
}
<text class="alarm-number" x="0" y="@(Priority is AlarmPriority.Medium ? "72" : "52")" text-anchor="middle">@((int)Priority)</text>

@code {
    [Parameter, EditorRequired] public AlarmPriority Priority { get; set; }
}
